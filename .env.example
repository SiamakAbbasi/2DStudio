# Copy to .env.local and supply local-only values. Never commit real secrets.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/2dstudio
SESSION_SECRET=replace-with-a-long-random-local-secret
PORT=5175
APP_ORIGIN=http://127.0.0.1:5174
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-one-time-bootstrap-password
GENERAL_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=5
PROJECT_BODY_LIMIT=10mb

